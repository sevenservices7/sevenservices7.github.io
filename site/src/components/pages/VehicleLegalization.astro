---
import { useTranslations, getRoute, type Lang } from '../../i18n/ui';
import { getOffices } from '../../lib/data';
import WhatsAppButton from '../WhatsAppButton.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const offices = await getOffices();
const hq = offices.find((o) => o.slug === 'albufeira') ?? offices[0];
const waNumber = hq?.whatsapp ?? '351939146298';

const copy = {
  pt: {
    heroEyebrow: 'Serviços para veículos',
    heroTitle: 'Legalização de', heroTitleEm: 'veículos', heroTitleAfter: 'em Portugal',
    heroLede: 'Importou o seu carro para Portugal? Tratamos de todo o processo de legalização — da simulação do ISV à matrícula nacional e ao registo de propriedade. Sem filas, sem surpresas.',
    heroCtaPrimary: 'Falar com um especialista',
    heroCtaSecondary: 'Ver como funciona',

    whoEyebrow: 'Para quem é', whoTitle: 'Em que situações ajudamos',
    whoSub: 'Se trouxe — ou vai trazer — um veículo para Portugal, tratamos da legalização de ponta a ponta.',
    who: [
      ['Importação da UE', 'Carros comprados noutro país da União Europeia que precisam de matrícula portuguesa.'],
      ['Importação de fora da UE', 'Veículos vindos de países terceiros, com despacho aduaneiro e homologação técnica.'],
      ['Mudança de residência', 'Transferiu a sua residência para Portugal e quer legalizar o veículo que já tinha.'],
      ['Herança ou transferência', 'Veículos recebidos por herança ou transferidos de outro titular que exigem regularização.'],
    ],

    stepsEyebrow: 'Como funciona', stepsTitle: 'O processo, passo a passo',
    stepsSub: 'Um caminho claro, do primeiro contacto à matrícula portuguesa na sua mão.',
    steps: [
      ['01', 'Avaliação e simulação de ISV', 'Analisamos o veículo e os documentos e calculamos o ISV à partida — sabe quanto vai pagar antes de avançar.'],
      ['02', 'Inspeção e documentação técnica', 'Tratamos da inspeção tipo B e do Certificado de Conformidade (COC) ou homologação (Modelo 9 do IMT).'],
      ['03', 'Despacho aduaneiro e ISV', 'Submetemos a DAV e liquidamos o Imposto Sobre Veículos junto da Alfândega / Autoridade Tributária.'],
      ['04', 'Matrícula no IMT', 'Pedimos a atribuição da matrícula nacional e a emissão dos documentos do veículo.'],
      ['05', 'Registo, IUC e seguro', 'Finalizamos o registo de propriedade e orientamos sobre IUC e seguro — pronto a circular.'],
    ],

    inclEyebrow: 'Serviço completo', inclTitle: 'O que tratamos por si',
    inclSub: 'Um único interlocutor para todas as etapas e organismos.',
    incl: [
      ['Simulação de ISV', 'Cálculo do imposto à partida, sem surpresas no fim.'],
      ['Inspeção e homologação', 'Inspeção tipo B, COC e homologação técnica quando necessária.'],
      ['Despacho aduaneiro (DAV)', 'Tratamento da declaração aduaneira e pagamento do ISV.'],
      ['Matrícula e documentos', 'Atribuição de matrícula portuguesa e emissão do documento único (DUA).'],
      ['Registo de propriedade', 'Registo na Conservatória em seu nome, com segurança jurídica.'],
      ['Gestor dedicado', 'Uma pessoa responsável que o acompanha do início ao fim.'],
    ],

    docsEyebrow: 'Documentação', docsTitle: 'Documentos necessários',
    docsSub: 'O que normalmente é preciso. Confirmamos a lista exata no diagnóstico do seu caso.',
    docs: [
      'Documento de propriedade do país de origem',
      'Certificado de Conformidade (COC) ou ficha técnica',
      'Fatura de compra ou contrato',
      'Documento de identificação e NIF do proprietário',
      'Comprovativo de morada em Portugal',
      'Certificado de cancelamento de matrícula na origem',
    ],

    priceEyebrow: 'Investimento', priceTitle: 'Quanto custa',
    priceBody: 'O custo da legalização depende sobretudo do ISV, que varia com o veículo (cilindrada, emissões e idade). Por isso começamos sempre por uma simulação transparente.',
    priceNote: 'Consultoria inicial a partir de 80 € — descontável se avançar com o serviço.',
    priceCta: 'Pedir simulação de ISV',

    whyEyebrow: 'Porquê a Seven', whyTitle: 'Porque confiar em nós',
    why: [
      ['Processo ponta a ponta', 'Tratamos de tudo — IMT, Alfândega, inspeção e registo — sem o deixar a correr entre repartições.'],
      ['Online primeiro', 'Resolve a partir de onde estiver. Só se desloca quando é mesmo indispensável.'],
      ['Transparência total', 'Dizemos os custos à partida e explicamos cada etapa. Zero surpresas.'],
    ],

    faqEyebrow: 'Dúvidas', faqTitle: 'Perguntas frequentes',
    faq: [
      ['Quanto tempo demora a legalização?', 'Depende do tipo de veículo e da origem, mas a maioria dos processos resolve-se em poucas semanas. No diagnóstico damos-lhe uma estimativa realista para o seu caso.'],
      ['Quanto vou pagar de ISV?', 'O ISV varia com a cilindrada, as emissões de CO₂ e a idade do veículo. Fazemos uma simulação à partida para saber o valor antes de avançar.'],
      ['Preciso de me deslocar?', 'Na maioria dos casos tratamos de tudo online; só o veículo precisa de estar disponível para a inspeção. Onde for preciso, indicamos exatamente o quê e onde.'],
      ['Posso conduzir o carro enquanto está em processo?', 'Enquanto o veículo não tem matrícula portuguesa há regras a cumprir. Orientamos sobre o que pode e não pode fazer para circular dentro da lei.'],
      ['Que veículos podem ser legalizados?', 'Tratamos veículos importados da UE e de fora da UE. Cada origem tem requisitos próprios — analisamos a viabilidade no início, sem compromisso.'],
    ],

    ctaClosing: 'Um processo. Um responsável. Zero surpresas.',
    ctaEyebrow: 'Pronto para começar?', ctaTitle: 'Legalize o seu veículo com a Seven',
    ctaBody: 'Fale connosco e receba uma simulação de ISV e o plano completo para a matrícula portuguesa.',
    ctaPrimary: 'Falar com um especialista', ctaBooking: 'Agendar consultoria',
    waText: 'Olá! Gostava de legalizar um veículo em Portugal.',
  },
  en: {
    heroEyebrow: 'Vehicle services',
    heroTitle: 'Vehicle', heroTitleEm: 'legalization', heroTitleAfter: 'in Portugal',
    heroLede: 'Brought your car into Portugal? We handle the whole legalization process — from the ISV simulation to the national plate and ownership registration. No queues, no surprises.',
    heroCtaPrimary: 'Talk to a specialist',
    heroCtaSecondary: 'See how it works',

    whoEyebrow: 'Who it’s for', whoTitle: 'When we can help',
    whoSub: 'If you’ve brought — or are about to bring — a vehicle into Portugal, we handle the legalization end to end.',
    who: [
      ['Import from the EU', 'Cars bought in another EU country that need a Portuguese plate.'],
      ['Import from outside the EU', 'Vehicles from third countries, with customs clearance and technical approval.'],
      ['Change of residence', 'You moved your residence to Portugal and want to legalize the vehicle you already had.'],
      ['Inheritance or transfer', 'Vehicles received through inheritance or transferred from another owner that need regularization.'],
    ],

    stepsEyebrow: 'How it works', stepsTitle: 'The process, step by step',
    stepsSub: 'A clear path, from first contact to the Portuguese plate in your hands.',
    steps: [
      ['01', 'Assessment and ISV simulation', 'We review the vehicle and documents and calculate the ISV up front — you know what you’ll pay before moving ahead.'],
      ['02', 'Inspection and technical documents', 'We handle the type-B inspection and the Certificate of Conformity (COC) or approval (IMT Model 9).'],
      ['03', 'Customs clearance and ISV', 'We submit the DAV and settle the Vehicle Tax with Customs / the Tax Authority.'],
      ['04', 'IMT registration', 'We request the national plate and the issuing of the vehicle documents.'],
      ['05', 'Ownership, IUC and insurance', 'We finalize the ownership record and guide you on IUC and insurance — ready to drive.'],
    ],

    inclEyebrow: 'Full service', inclTitle: 'What we handle for you',
    inclSub: 'A single point of contact for every step and authority.',
    incl: [
      ['ISV simulation', 'Tax calculated up front, no surprises at the end.'],
      ['Inspection and approval', 'Type-B inspection, COC and technical approval when needed.'],
      ['Customs clearance (DAV)', 'Handling the customs declaration and ISV payment.'],
      ['Plate and documents', 'Portuguese plate assignment and issuing of the single document (DUA).'],
      ['Ownership registration', 'Registration in your name, with legal certainty.'],
      ['Dedicated manager', 'One person responsible who follows you from start to finish.'],
    ],

    docsEyebrow: 'Documentation', docsTitle: 'Documents you’ll need',
    docsSub: 'What’s usually required. We confirm the exact list when we assess your case.',
    docs: [
      'Proof of ownership from the country of origin',
      'Certificate of Conformity (COC) or technical sheet',
      'Purchase invoice or contract',
      'Owner’s ID and NIF',
      'Proof of address in Portugal',
      'Plate cancellation certificate from the origin',
    ],

    priceEyebrow: 'Investment', priceTitle: 'How much it costs',
    priceBody: 'The cost of legalization depends mostly on the ISV, which varies with the vehicle (engine size, emissions and age). That’s why we always start with a transparent simulation.',
    priceNote: 'Initial consultation from €80 — deductible if you proceed with the service.',
    priceCta: 'Request an ISV simulation',

    whyEyebrow: 'Why Seven', whyTitle: 'Why trust us',
    why: [
      ['End-to-end process', 'We handle it all — IMT, Customs, inspection and registration — without leaving you running between offices.'],
      ['Online first', 'Sort it out from wherever you are. You only travel when it’s truly unavoidable.'],
      ['Full transparency', 'We state the costs up front and explain every step. Zero surprises.'],
    ],

    faqEyebrow: 'Questions', faqTitle: 'Frequently asked questions',
    faq: [
      ['How long does legalization take?', 'It depends on the type of vehicle and its origin, but most cases are resolved in a few weeks. In the assessment we give you a realistic estimate for your case.'],
      ['How much ISV will I pay?', 'ISV varies with engine size, CO₂ emissions and the vehicle’s age. We run a simulation up front so you know the amount before proceeding.'],
      ['Do I need to travel?', 'In most cases we handle everything online; only the vehicle needs to be available for inspection. Where travel is needed, we tell you exactly what and where.'],
      ['Can I drive the car while it’s in process?', 'Until the vehicle has a Portuguese plate there are rules to follow. We guide you on what you can and can’t do to drive within the law.'],
      ['Which vehicles can be legalized?', 'We handle vehicles imported from the EU and from outside the EU. Each origin has its own requirements — we assess feasibility at the start, with no commitment.'],
    ],

    ctaClosing: 'One process. One owner. Zero surprises.',
    ctaEyebrow: 'Ready to start?', ctaTitle: 'Legalize your vehicle with Seven',
    ctaBody: 'Talk to us and get an ISV simulation and the full plan for your Portuguese plate.',
    ctaPrimary: 'Talk to a specialist', ctaBooking: 'Book a consultation',
    waText: 'Hi! I’d like to legalize a vehicle in Portugal.',
  },
  es: {
    heroEyebrow: 'Servicios para vehículos',
    heroTitle: 'Legalización de', heroTitleEm: 'vehículos', heroTitleAfter: 'en Portugal',
    heroLede: '¿Trajo su coche a Portugal? Nos ocupamos de todo el proceso de legalización — de la simulación del ISV a la matrícula nacional y al registro de propiedad. Sin colas, sin sorpresas.',
    heroCtaPrimary: 'Hablar con un especialista',
    heroCtaSecondary: 'Ver cómo funciona',

    whoEyebrow: 'Para quién es', whoTitle: 'En qué situaciones ayudamos',
    whoSub: 'Si trajo — o va a traer — un vehículo a Portugal, nos ocupamos de la legalización de principio a fin.',
    who: [
      ['Importación de la UE', 'Coches comprados en otro país de la Unión Europea que necesitan matrícula portuguesa.'],
      ['Importación de fuera de la UE', 'Vehículos de terceros países, con despacho aduanero y homologación técnica.'],
      ['Cambio de residencia', 'Trasladó su residencia a Portugal y quiere legalizar el vehículo que ya tenía.'],
      ['Herencia o transferencia', 'Vehículos recibidos por herencia o transferidos de otro titular que exigen regularización.'],
    ],

    stepsEyebrow: 'Cómo funciona', stepsTitle: 'El proceso, paso a paso',
    stepsSub: 'Un camino claro, del primer contacto a la matrícula portuguesa en su mano.',
    steps: [
      ['01', 'Evaluación y simulación del ISV', 'Analizamos el vehículo y los documentos y calculamos el ISV de inicio — sabe cuánto va a pagar antes de avanzar.'],
      ['02', 'Inspección y documentación técnica', 'Nos ocupamos de la inspección tipo B y del Certificado de Conformidad (COC) u homologación (Modelo 9 del IMT).'],
      ['03', 'Despacho aduanero e ISV', 'Presentamos la DAV y liquidamos el Impuesto Sobre Vehículos ante la Aduana / Autoridad Tributaria.'],
      ['04', 'Matrícula en el IMT', 'Solicitamos la asignación de la matrícula nacional y la emisión de los documentos del vehículo.'],
      ['05', 'Registro, IUC y seguro', 'Finalizamos el registro de propiedad y le orientamos sobre el IUC y el seguro — listo para circular.'],
    ],

    inclEyebrow: 'Servicio completo', inclTitle: 'De qué nos ocupamos por usted',
    inclSub: 'Un único interlocutor para todas las etapas y organismos.',
    incl: [
      ['Simulación del ISV', 'Cálculo del impuesto de inicio, sin sorpresas al final.'],
      ['Inspección y homologación', 'Inspección tipo B, COC y homologación técnica cuando es necesaria.'],
      ['Despacho aduanero (DAV)', 'Gestión de la declaración aduanera y el pago del ISV.'],
      ['Matrícula y documentos', 'Asignación de matrícula portuguesa y emisión del documento único (DUA).'],
      ['Registro de propiedad', 'Registro a su nombre, con seguridad jurídica.'],
      ['Gestor dedicado', 'Una persona responsable que le acompaña de principio a fin.'],
    ],

    docsEyebrow: 'Documentación', docsTitle: 'Documentos necesarios',
    docsSub: 'Lo que normalmente se necesita. Confirmamos la lista exacta en el diagnóstico de su caso.',
    docs: [
      'Documento de propiedad del país de origen',
      'Certificado de Conformidad (COC) o ficha técnica',
      'Factura de compra o contrato',
      'Documento de identificación y NIF del propietario',
      'Justificante de domicilio en Portugal',
      'Certificado de baja de matrícula en el origen',
    ],

    priceEyebrow: 'Inversión', priceTitle: 'Cuánto cuesta',
    priceBody: 'El coste de la legalización depende sobre todo del ISV, que varía según el vehículo (cilindrada, emisiones y antigüedad). Por eso empezamos siempre con una simulación transparente.',
    priceNote: 'Consultoría inicial desde 80 € — descontable si avanza con el servicio.',
    priceCta: 'Pedir simulación del ISV',

    whyEyebrow: 'Por qué Seven', whyTitle: 'Por qué confiar en nosotros',
    why: [
      ['Proceso de principio a fin', 'Nos ocupamos de todo — IMT, Aduana, inspección y registro — sin dejarle corriendo entre oficinas.'],
      ['Online primero', 'Resuélvalo desde donde esté. Solo se desplaza cuando es imprescindible.'],
      ['Transparencia total', 'Indicamos los costes de inicio y explicamos cada etapa. Cero sorpresas.'],
    ],

    faqEyebrow: 'Dudas', faqTitle: 'Preguntas frecuentes',
    faq: [
      ['¿Cuánto tarda la legalización?', 'Depende del tipo de vehículo y del origen, pero la mayoría de los casos se resuelven en pocas semanas. En el diagnóstico le damos una estimación realista para su caso.'],
      ['¿Cuánto voy a pagar de ISV?', 'El ISV varía según la cilindrada, las emisiones de CO₂ y la antigüedad del vehículo. Hacemos una simulación de inicio para conocer el importe antes de avanzar.'],
      ['¿Necesito desplazarme?', 'En la mayoría de los casos nos ocupamos de todo online; solo el vehículo debe estar disponible para la inspección. Donde haga falta, le indicamos exactamente qué y dónde.'],
      ['¿Puedo conducir el coche mientras está en proceso?', 'Mientras el vehículo no tiene matrícula portuguesa hay reglas que cumplir. Le orientamos sobre lo que puede y no puede hacer para circular dentro de la ley.'],
      ['¿Qué vehículos pueden legalizarse?', 'Tratamos vehículos importados de la UE y de fuera de la UE. Cada origen tiene sus propios requisitos — analizamos la viabilidad al inicio, sin compromiso.'],
    ],

    ctaClosing: 'Un proceso. Un responsable. Cero sorpresas.',
    ctaEyebrow: '¿Listo para empezar?', ctaTitle: 'Legalice su vehículo con Seven',
    ctaBody: 'Hable con nosotros y reciba una simulación del ISV y el plan completo para su matrícula portuguesa.',
    ctaPrimary: 'Hablar con un especialista', ctaBooking: 'Agendar consultoría',
    waText: '¡Hola! Me gustaría legalizar un vehículo en Portugal.',
  },
}[lang];
---
<!-- HERO -->
<section class="hero bg-navy">
  <div class="container hero-in">
    <span class="eyebrow">{copy.heroEyebrow}</span>
    <h1>{copy.heroTitle} <em>{copy.heroTitleEm}</em> {copy.heroTitleAfter}</h1>
    <p class="hero-lede">{copy.heroLede}</p>
    <div class="hero-ctas">
      <button class="btn btn-gold" data-open-attendance>{copy.heroCtaPrimary}</button>
      <a href="#como-funciona" class="btn btn-light">{copy.heroCtaSecondary}</a>
    </div>
  </div>
  <div class="hero-mark" aria-hidden="true"></div>
</section>

<!-- PARA QUEM É -->
<section class="bg-off">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">{copy.whoEyebrow}</span>
      <h2>{copy.whoTitle}</h2>
      <p class="lead">{copy.whoSub}</p>
    </div>
    <div class="quad">
      {copy.who.map(([title, body]) => (
        <div class="card who-card"><h3>{title}</h3><p>{body}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- COMO FUNCIONA -->
<section id="como-funciona" class="bg-white">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">{copy.stepsEyebrow}</span>
      <h2>{copy.stepsTitle}</h2>
      <p class="lead">{copy.stepsSub}</p>
    </div>
    <div class="steps">
      {copy.steps.map(([n, ti, d]) => (
        <div class="step"><div class="step-num">{n}</div><h4>{ti}</h4><p>{d}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- O QUE TRATAMOS -->
<section class="bg-off">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">{copy.inclEyebrow}</span>
      <h2>{copy.inclTitle}</h2>
      <p class="lead">{copy.inclSub}</p>
    </div>
    <div class="grid cols-3">
      {copy.incl.map(([title, body]) => (
        <div class="card incl-card"><h3>{title}</h3><p>{body}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- DOCUMENTOS -->
<section class="bg-white">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">{copy.docsEyebrow}</span>
      <h2>{copy.docsTitle}</h2>
      <p class="lead">{copy.docsSub}</p>
    </div>
    <ul class="checklist">
      {copy.docs.map((d) => (
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          <span>{d}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- INVESTIMENTO / CONSULTORIA -->
<section class="bg-off">
  <div class="container">
    <div class="price-card">
      <span class="eyebrow">{copy.priceEyebrow}</span>
      <h2>{copy.priceTitle}</h2>
      <p class="lead" style="margin-inline:auto">{copy.priceBody}</p>
      <p class="price-note">{copy.priceNote}</p>
      <button class="btn btn-gold" data-open-attendance>{copy.priceCta}</button>
    </div>
  </div>
</section>

<!-- PORQUÊ A SEVEN -->
<section class="bg-white">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">{copy.whyEyebrow}</span>
      <h2>{copy.whyTitle}</h2>
    </div>
    <div class="grid cols-3">
      {copy.why.map(([title, body]) => (
        <div class="card why-card"><h3>{title}</h3><p>{body}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="bg-off">
  <div class="container" style="max-width:820px">
    <div class="section-head center">
      <span class="eyebrow">{copy.faqEyebrow}</span>
      <h2>{copy.faqTitle}</h2>
    </div>
    <div class="faq">
      {copy.faq.map(([q, a]) => (
        <details class="faq-item">
          <summary>{q}<span class="faq-ic" aria-hidden="true"></span></summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- CTA FINAL -->
<section class="bg-navy cta-band">
  <div class="container center">
    <p class="closing-line">{copy.ctaClosing}</p>
    <span class="eyebrow">{copy.ctaEyebrow}</span>
    <h2>{copy.ctaTitle}</h2>
    <p class="lead" style="margin-inline:auto">{copy.ctaBody}</p>
    <div class="cta-actions">
      <button class="btn btn-gold" data-open-attendance>{copy.ctaPrimary}</button>
      <WhatsAppButton whatsapp={waNumber} text={copy.waText} label={t('common.whatsapp')} />
      <a href={getRoute('booking', lang)} class="btn btn-light">{copy.ctaBooking}</a>
    </div>
  </div>
</section>

<style>
  /* HERO (replicado de Home.astro p/ consistência) */
  .hero { position: relative; overflow: hidden; padding: clamp(72px, 11vw, 120px) 0; }
  .hero-in { position: relative; z-index: 1; }
  .hero h1 { font-size: clamp(2.6rem, 6vw, 4.75rem); line-height: 1.04; letter-spacing: -0.015em; max-width: 16ch; text-wrap: balance; }
  .hero h1 em { font-style: italic; font-weight: 300; color: var(--g1); }
  .hero-lede { color: rgba(255,255,255,.8); max-width: 600px; font-size: clamp(1.05rem, 1.6vw, 1.2rem); margin: 24px 0 36px; line-height: 1.55; }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-mark {
    position: absolute; right: -90px; bottom: -90px; width: min(620px, 70vw); height: min(620px, 70vw);
    background: url('/brand/logo_isotype_white_gold.png') center/contain no-repeat; opacity: .2;
    pointer-events: none; filter: drop-shadow(0 20px 60px rgba(0,0,0,.35));
  }

  /* GRID DE 4 (para quem é) */
  .quad { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px, 2.2vw, 22px); }
  .who-card, .incl-card, .why-card { padding: 26px; height: 100%; }
  .who-card h3, .incl-card h3, .why-card h3 { font-size: 1.1rem; color: var(--seven-navy-deep); margin-bottom: 10px; }
  .who-card p, .incl-card p, .why-card p { color: var(--seven-muted); font-size: .92rem; line-height: 1.6; }

  /* PASSOS (replicado de Home.astro) */
  .steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; }
  .step { padding-top: 56px; position: relative; }
  .step-num { position: absolute; top: 0; left: 0; font-family: var(--font-head); font-weight: 300; font-style: italic; font-size: 3.4rem; line-height: 1; color: var(--g2); opacity: .9; }
  .step h4 { font-weight: 600; text-transform: uppercase; letter-spacing: var(--tracking-wide); font-size: .9rem; margin-bottom: 8px; }
  .step p { color: var(--seven-muted); font-size: .9rem; line-height: 1.55; }

  /* CHECKLIST DE DOCUMENTOS */
  .checklist { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 14px 28px; max-width: 880px; margin-inline: auto; }
  .checklist li { display: flex; align-items: flex-start; gap: 12px; padding: 14px 18px; background: var(--seven-white); border: 1px solid var(--seven-line); border-radius: var(--r-md); box-shadow: var(--shadow-sm); }
