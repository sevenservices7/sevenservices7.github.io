---
import { useTranslations, type Lang } from '../../i18n/ui';
import { getTeam } from '../../lib/data';
import { initials } from '../../lib/format';
import PersonCard from '../PersonCard.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const team = await getTeam();
const founder = team.find((m) => m.founder) ?? team[0];
const others = team.filter((m) => m !== founder);

type Bio = { role: string; languages: string; phrase: string };
const TEAM: Record<Lang, Record<string, Bio>> = {
  pt: {
    DJ: { role: 'Fundador e CEO · Operações', languages: 'Português, espanhol', phrase: '“Me traz o problema, que eu trago a solução.” Rápido e determinado, ele cuida de como cada processo anda, com um objetivo só: que o cliente conquiste o que veio buscar.' },
    DG: { role: 'Sócio · Diretor de Gestão e Performance', languages: 'Português, inglês', phrase: 'Cuida do time, das metas e dos resultados. É quem garante que a SEVEN entregue o que promete, todo mês.' },
    AK: { role: 'Advogada', languages: 'Português, inglês', phrase: 'Senso de justiça forte e muita empatia. É ela quem garante que cada processo está em terreno legal firme.' },
    MC: { role: 'Gestora Comercial', languages: 'Português, inglês', phrase: 'É a primeira conversa de quem chega. Entende o caso e indica o caminho certo, sem vender o que você não precisa.' },
    GR: { role: 'Gestora de Onboarding', languages: 'Português, inglês, espanhol', phrase: 'Recebe cada cliente que fecha com a SEVEN e organiza os primeiros passos. Inteligente, rápida e atenciosa.' },
    DS: { role: 'Gestora de Unidade · Faro', languages: 'Português', phrase: 'Contadora de formação e simpatia em pessoa. Cuida de quem chega a Faro com a atenção de quem lida com gente, não com papel.' },
    MI: { role: 'Contabilista Certificada', languages: '', phrase: 'Cuida da contabilidade de empresas e trabalhadores independentes, com impostos e obrigações em dia.' },
    DN: { role: 'Marketing · Direção Criativa', languages: 'Português, inglês', phrase: 'Filma, cria e tem as ideias. É quem transforma a história da SEVEN e dos clientes em conteúdo.' },
    TH: { role: 'Marketing · Edição e Conteúdo', languages: 'Português, italiano', phrase: 'Edita o podcast, os carrosséis, os posts e os reels. Cada vídeo que você vê da SEVEN passa pelas mãos dela.' },
  },
  en: {
    DJ: { role: 'Founder & CEO · Operations', languages: 'Portuguese, Spanish', phrase: '«Bring me the problem, and I’ll bring the solution.» Fast and determined, he has one goal: that the client gets what they came for.' },
    DG: { role: 'Partner · Director of Management & Performance', languages: 'Portuguese, English', phrase: 'Leads the team, goals and results.' },
    AK: { role: 'Lawyer', languages: 'Portuguese, English', phrase: 'A strong sense of justice and great empathy. She makes sure every case stands on solid legal ground.' },
    MC: { role: 'Sales Manager', languages: 'Portuguese, English', phrase: 'The first conversation for anyone who reaches out.' },
    GR: { role: 'Onboarding Manager', languages: 'Portuguese, English, Spanish', phrase: 'Welcomes every new client and organises the first steps.' },
    DS: { role: 'Branch Manager · Faro', languages: 'Portuguese', phrase: 'An accountant by training, kindness in person. She looks after those who arrive in Faro with the care of someone who handles people, not papers.' },
    MI: { role: 'Certified Accountant', languages: '', phrase: 'Handles accounting for companies and freelancers.' },
    DN: { role: 'Marketing · Creative Director', languages: 'Portuguese, English', phrase: 'Films, creates and comes up with the ideas.' },
    TH: { role: 'Marketing · Editing & Content', languages: 'Portuguese, Italian', phrase: 'Edits the podcast, carousels, posts and reels.' },
  },
  es: {
    DJ: { role: 'Fundador & CEO · Operaciones', languages: 'Portugués, español', phrase: '«Tráeme el problema, que yo traigo la solución.» Rápido y decidido, su objetivo es uno solo: que el cliente consiga lo que vino a buscar.' },
    DG: { role: 'Socio · Director de Gestión y Resultados', languages: 'Portugués, inglés', phrase: 'Lidera el equipo, las metas y los resultados.' },
    AK: { role: 'Abogada', languages: 'Portugués, inglés', phrase: 'Alto sentido de la justicia y mucha empatía. Es quien garantiza que cada proceso se asienta en terreno legal firme.' },
    MC: { role: 'Gerente Comercial', languages: 'Portugués, inglés', phrase: 'La primera conversación de quien nos contacta.' },
    GR: { role: 'Gerente de Onboarding', languages: 'Portugués, inglés, español', phrase: 'Recibe a cada nuevo cliente y organiza los primeros pasos.' },
    DS: { role: 'Gerente de Sede · Faro', languages: 'Portugués', phrase: 'Contable de formación, simpatía en persona. Cuida de quien llega a Faro con la atención de quien trata con personas, no con papeles.' },
    MI: { role: 'Contable Certificada', languages: '', phrase: 'Lleva la contabilidad de empresas y autónomos.' },
    DN: { role: 'Marketing · Dirección Creativa', languages: 'Portugués, inglés', phrase: 'Filma, crea y tiene las ideas.' },
    TH: { role: 'Marketing · Edición y Contenido', languages: 'Portugués, italiano', phrase: 'Edita el pódcast, carruseles, posts y reels.' },
  },
};
const langsLabel = { pt: 'Idiomas', en: 'Languages', es: 'Idiomas' }[lang];
const closing = {
  pt: 'A gente atende em português, inglês e espanhol — na língua em que você se sentir mais à vontade.',
  en: 'We serve in Portuguese, English and Spanish — in whichever language you feel most comfortable.',
  es: 'Atendemos en portugués, inglés y español — en el idioma en el que se sienta cómodo.',
}[lang];
const info = (code: string): Bio => TEAM[lang][code] ?? { role: '', languages: '', phrase: '' };
const f = info(founder?.code ?? '');
---
<section class="bg-navy center">
  <div class="container" style="max-width:720px">
    <span class="eyebrow">{t('team.eyebrow')}</span>
    <h1>{t('team.title')}</h1>
  </div>
</section>

{founder && (
  <section>
    <div class="container founder-block">
      <div class="founder-photo">
        {founder.photo_url ? (
          <img src={founder.photo_url} alt={founder.name} />
        ) : (
          <span class="founder-initials" aria-hidden="true">{initials(founder.name)}</span>
        )}
      </div>
      <div>
        <span class="eyebrow">{f.role}</span>
        <h2>{founder.name}</h2>
        <p class="founder-langs">{langsLabel}: {f.languages}</p>
        <p class="lead" style="margin-top:12px">{f.phrase}</p>
      </div>
    </div>
  </section>
)}

<section class="bg-off">
  <div class="container">
    <div class="grid cols-3">
      {others.map((m) => (
        <PersonCard member={m} role={info(m.code).role} languages={info(m.code).languages} langsLabel={langsLabel} phrase={info(m.code).phrase} />
      ))}
    </div>
    <p class="team-closing center">{closing}</p>
  </div>
</section>

<style>
  .founder-block { display: grid; grid-template-columns: auto 1fr; gap: 40px; align-items: center; max-width: 860px; margin-inline: auto; }
  .founder-photo {
    width: 168px; height: 168px; border-radius: 50%; overflow: hidden; flex: none;
    background: var(--grad-navy); display: flex; align-items: center; justify-content: center;
    border: 3px solid var(--accent);
  }
  .founder-photo img { width: 100%; height: 100%; object-fit: cover; }
  .founder-initials { font-family: var(--font-head); font-weight: 700; font-size: 3rem; color: var(--g1); }
  .founder-langs { font-family: var(--font-head); font-size: .74rem; text-transform: uppercase; letter-spacing: var(--tracking-wide); color: var(--g0); margin: 6px 0 0; }
  .team-closing { margin-top: 40px; font-family: var(--font-head); font-weight: 500; font-size: clamp(1.1rem, 2.2vw, 1.35rem); color: var(--heading); max-width: 720px; margin-inline: auto; }
  @media (max-width: 680px) { .founder-block { grid-template-columns: 1fr; text-align: center; justify-items: center; } }
</style>
